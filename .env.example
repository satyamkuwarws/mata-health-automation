# Environment and credentials (NEVER commit real values)
ENV=local

# Base URLs
BASE_URL=https://nimble-pasca-24ee4c.netlify.app/admin
API_BASE_URL=https://api.example-healthcare.com

# Admin identity (optional; helps prefill email in manual OTP login)
ADMIN_EMAIL=admin@example.com

# Playwright / execution
BROWSER=chromium
HEADLESS=false
SLOW_MO_MS=0
DEFAULT_TIMEOUT_MS=15000
EXPECT_TIMEOUT_MS=10000
NAVIGATION_TIMEOUT_MS=30000

# Storage state (login reuse)
STORAGE_STATE_DIR=reports/artifacts/storage

# Artifacts
ARTIFACTS_DIR=reports/artifacts
SCREENSHOTS_DIR=reports/artifacts/screenshots
TRACES_DIR=reports/artifacts/traces
VIDEOS_DIR=reports/artifacts/videos

# Logging
LOG_LEVEL=INFO
LOG_DIR=reports/logs

